{
  "name": "@qelvra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",

    "pty:smoke": "tsx scripts/pty-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@qelvra/shared": "^0.0.0",
    "fastify": "^5.12.5",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  }
}

{
  "name": "@qelvra/server",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "pty:smoke": "tsx scripts/pty-smoke.ts",
    "mailbox:smoke": "tsx scripts/mailbox-smoke.ts",
    "router:smoke": "tsx scripts/router-smoke.ts",
    "fake:smoke": "tsx scripts/fake-agent-smoke.ts",
    "task:smoke": "tsx scripts/task-smoke.ts",
    "activity:smoke": "tsx scripts/activity-smoke.ts",
    "provider:smoke": "tsx scripts/provider-smoke.ts",
    "execution:smoke": "tsx scripts/execution-smoke.ts",
    "execution:bundle-smoke": "node scripts/execution-bundle-smoke.mjs",
    "orchestration:smoke": "tsx scripts/orchestration-smoke.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "release:soak": "tsx scripts/release-smoke.ts --soak",
    "production:smoke": "node scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@qelvra/shared": "0.1.0-beta.1",
    "chokidar": "^4.0.3",
    "fastify": "^5.12.5",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  }
}

# Copy to apps/server/.env to override defaults. Never commit real secrets.

# Interface to bind. Keep loopback unless you add authentication (see docs/adr/0003).
HOST=127.0.0.1
PORT=3001

# Browser origin(s) allowed by CORS, comma-separated. Must match the web dev server URL.
WEB_ORIGIN=http://127.0.0.1:5173

# Directory scratch/developer PTY sessions start in. Defaults to the server's cwd.
# WORKSPACE_ROOT=/absolute/path/to/workspace

# Where the server keeps agents.json and hive/agents/<id> workspaces. Agent shells use
# their own workspace cwd. Relative DATA_DIR paths resolve against the server's
# working directory. Defaults to .qelvra (git-ignored).
# DATA_DIR=.qelvra

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

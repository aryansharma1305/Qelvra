# Copy to apps/server/.env (server runs with that workspace as cwd).
# Relative server paths below resolve from apps/server, not repository root.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DIR=.qelvra
WORKSPACE_ROOT=.
LOG_LEVEL=info
NODE_ENV=development
EXECUTION_TIMEOUT_MS=1200000
ORCHESTRATION_MAX_TASKS=20
ORCHESTRATION_MAX_ATTEMPTS=3
ORCHESTRATION_MAX_CONCURRENT=3
ORCHESTRATION_TIMEOUT_MS=3600000
# Optional FRONTEND setting: put in apps/web/.env.local instead.
# VITE_API_URL=http://127.0.0.1:3001
